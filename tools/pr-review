#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# === Configuration ===
PR_NUMBER=""
REPO_FLAG=""
RUN_CLAUDE=true
RUN_CODEX=true
ORIGINAL_BRANCH=""
TEMP_DIR=""
CHECKOUT_SUCCEEDED=false
PROGRESS_PID=""
PROGRESS_LINES=0

# === Progress Monitor ===
show_progress() {
  local start=$SECONDS
  local chars='|/-\'
  local i=0

  while true; do
    local elapsed=$(( SECONDS - start ))
    local spinner="${chars:i%${#chars}:1}"

    # Erase previous block
    if [ $PROGRESS_LINES -gt 0 ]; then
      printf "\033[%dA" "$PROGRESS_LINES" >&2
      for _ in $(seq 1 $PROGRESS_LINES); do
        printf "\033[K\n" >&2
      done
      printf "\033[%dA" "$PROGRESS_LINES" >&2
    fi

    local lines=0
    printf "  %s Reviewing (%ds)\n" "$spinner" "$elapsed" >&2; lines=$((lines+1))

    # Claude status
    if [ -f "$TEMP_DIR/claude_review_stream.jsonl" ]; then
      local claude_status
      claude_status=$(tail -20 "$TEMP_DIR/claude_review_stream.jsonl" 2>/dev/null | \
        jq -r '
          if .type == "assistant" then
            .message.content[-1]? |
            if .type == "tool_use" then "🔧 " + (.name // "tool") + " " + ((.input | tostring)[0:60] // "")
            elif .type == "text" then "💬 " + (.text | split("\n") | last | .[0:80])
            else empty
            end
          else empty
          end
        ' 2>/dev/null | tail -1)
      if [ -n "$claude_status" ]; then
        printf "  Claude: %s\n" "$claude_status" >&2; lines=$((lines+1))
      else
        printf "  Claude: waiting...\n" >&2; lines=$((lines+1))
      fi
    fi

    # Codex status
    if [ -f "$TEMP_DIR/codex_review.txt" ]; then
      local codex_status
      codex_status=$(tail -1 "$TEMP_DIR/codex_review.txt" 2>/dev/null | head -c 80)
      if [ -n "$codex_status" ]; then
        printf "  Codex:  %s\n" "$codex_status" >&2; lines=$((lines+1))
      else
        printf "  Codex:  waiting...\n" >&2; lines=$((lines+1))
      fi
    fi

    PROGRESS_LINES=$lines
    i=$((i+1))
    sleep 1
  done
}

start_progress() {
  PROGRESS_LINES=0
  show_progress &
  PROGRESS_PID=$!
}

stop_progress() {
  if [ -n "$PROGRESS_PID" ] && kill -0 "$PROGRESS_PID" 2>/dev/null; then
    kill "$PROGRESS_PID" 2>/dev/null
    wait "$PROGRESS_PID" 2>/dev/null || true
    # Erase the progress block
    if [ $PROGRESS_LINES -gt 0 ]; then
      printf "\033[%dA" "$PROGRESS_LINES" >&2
      for _ in $(seq 1 $PROGRESS_LINES); do
        printf "\033[K\n" >&2
      done
      printf "\033[%dA" "$PROGRESS_LINES" >&2
    fi
    PROGRESS_PID=""
    PROGRESS_LINES=0
  fi
}

# === Cleanup ===
cleanup() {
  stop_progress

  # Restore original branch if we checked out a PR
  if [ "$CHECKOUT_SUCCEEDED" = true ] && [ -n "$ORIGINAL_BRANCH" ]; then
    git checkout "$ORIGINAL_BRANCH" --quiet 2>/dev/null || true
  fi

  # Remove temp files on success, preserve on failure
  if [ -n "$TEMP_DIR" ] && [ -d "$TEMP_DIR" ]; then
    if [ "${SCRIPT_EXIT_CODE:-1}" -eq 0 ]; then
      rm -rf "$TEMP_DIR"
    else
      echo "  Debug files preserved in: $TEMP_DIR" >&2
    fi
  fi
}
SCRIPT_EXIT_CODE=1
trap 'SCRIPT_EXIT_CODE=$?; cleanup' EXIT

# === Usage ===
usage() {
  cat <<EOF
Usage: pr-review [PR_NUMBER] [OPTIONS]

Review code using Claude Code and/or Codex in headless mode.
Without a PR number, reviews the current working copy.

Arguments:
    PR_NUMBER              Pull request number (optional)

Options:
    --repo OWNER/REPO      Target repository (default: current repo)
    --claude-only          Run only Claude Code review
    --codex-only           Run only Codex review
    -h, --help             Show this help message

Examples:
    pr-review              Review current working copy
    pr-review 42           Review PR #42
    pr-review 42 --repo octocat/hello-world
    pr-review --claude-only
EOF
}

# === Argument Parsing ===
while [ $# -gt 0 ]; do
  case "$1" in
    --repo)
      if [ -z "${2:-}" ]; then
        echo "Error: --repo requires OWNER/REPO argument"
        exit 1
      fi
      REPO_FLAG="--repo $2"
      shift 2
      ;;
    --claude-only)
      RUN_CODEX=false
      shift
      ;;
    --codex-only)
      RUN_CLAUDE=false
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Error: Unknown option '$1'"
      usage
      exit 1
      ;;
    *)
      if [ -z "$PR_NUMBER" ]; then
        PR_NUMBER="$1"
      else
        echo "Error: Unexpected argument '$1'"
        usage
        exit 1
      fi
      shift
      ;;
  esac
done

if [ -n "$PR_NUMBER" ] && ! [[ "$PR_NUMBER" =~ ^[0-9]+$ ]]; then
  echo "Error: PR number must be a positive integer"
  exit 1
fi

# === Validation ===
# Check requested tools are available
if [ "$RUN_CLAUDE" = true ] && ! command -v claude &>/dev/null; then
  echo "Warning: 'claude' not found in PATH"
  if [ "$RUN_CODEX" = false ]; then
    echo "Error: --claude-only specified but claude is not available"
    exit 1
  fi
  echo "Falling back to Codex only"
  RUN_CLAUDE=false
fi

if [ "$RUN_CODEX" = true ] && ! command -v codex &>/dev/null; then
  echo "Warning: 'codex' not found in PATH"
  if [ "$RUN_CLAUDE" = false ]; then
    echo "Error: --codex-only specified but codex is not available"
    exit 1
  fi
  echo "Falling back to Claude only"
  RUN_CODEX=false
fi

if [ "$RUN_CLAUDE" = false ] && [ "$RUN_CODEX" = false ]; then
  echo "Error: Neither claude nor codex is available"
  exit 1
fi

# === Setup ===
TEMP_DIR=$(mktemp -d)
REVIEW_SYSTEM_PROMPT=$(cat "$SCRIPT_DIR/pr-review-prompt.txt")
CONSOLIDATE_SYSTEM_PROMPT=$(cat "$SCRIPT_DIR/pr-review-consolidate.txt")

# === Mode: PR or working copy ===
if [ -n "$PR_NUMBER" ]; then
  # --- PR mode ---
  if ! gh auth status &>/dev/null; then
    echo "Error: GitHub CLI is not authenticated. Run 'gh auth login' first."
    exit 1
  fi

  # shellcheck disable=SC2086
  if ! gh pr view "$PR_NUMBER" $REPO_FLAG --json number &>/dev/null; then
    echo "Error: PR #$PR_NUMBER not found"
    exit 1
  fi

  echo "Fetching PR metadata..."
  # shellcheck disable=SC2086
  PR_META=$(gh pr view "$PR_NUMBER" $REPO_FLAG --json title,body,author,baseRefName,headRefName,additions,deletions)

  PR_TITLE=$(echo "$PR_META" | jq -r '.title')
  PR_AUTHOR=$(echo "$PR_META" | jq -r '.author.login')
  PR_BASE=$(echo "$PR_META" | jq -r '.baseRefName')
  PR_HEAD=$(echo "$PR_META" | jq -r '.headRefName')
  PR_ADDITIONS=$(echo "$PR_META" | jq -r '.additions')
  PR_DELETIONS=$(echo "$PR_META" | jq -r '.deletions')
  PR_BODY=$(echo "$PR_META" | jq -r '.body // "No description provided"')

  echo "=== PR Review: #$PR_NUMBER ==="
  echo "  Title:    $PR_TITLE"
  echo "  Author:   $PR_AUTHOR"
  echo "  Branch:   $PR_HEAD → $PR_BASE"
  echo "  Changes:  +$PR_ADDITIONS / -$PR_DELETIONS"
  echo ""

  echo "Checking out PR branch..."
  ORIGINAL_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

  # Configure git to use HTTPS instead of SSH for GitHub (avoids SSH key requirement in containers)
  git config --global url."https://github.com/".insteadOf "git@github.com:" 2>/dev/null || true
  gh auth setup-git 2>/dev/null || true

  # shellcheck disable=SC2086
  if ! gh pr checkout "$PR_NUMBER" $REPO_FLAG --force 2>&1; then
    echo "Error: Could not checkout PR branch. Aborting."
    exit 1
  fi
  CHECKOUT_SUCCEEDED=true
  echo "  Checked out branch: $PR_HEAD"
  echo ""

  REVIEW_CONTEXT="Review PR #$PR_NUMBER: $PR_TITLE by $PR_AUTHOR ($PR_HEAD → $PR_BASE, +$PR_ADDITIONS/-$PR_DELETIONS).
Description: $PR_BODY

Use 'git diff $PR_BASE...HEAD' to see the changes. Use Read, Glob, Grep to explore the code."
  REVIEW_LABEL="PR #$PR_NUMBER"
  REVIEW_FILE="review_${PR_NUMBER}.md"
  HEADER_META="- **Author:** $PR_AUTHOR
- **Branch:** $PR_HEAD → $PR_BASE
- **Changes:** +$PR_ADDITIONS / -$PR_DELETIONS"

else
  # --- Working copy mode ---
  echo "=== Code Review: working copy ==="
  echo ""

  REVIEW_CONTEXT="Review the current working copy. Use 'git diff' and 'git diff --cached' to see uncommitted changes. Use Read, Glob, Grep to explore the code."
  REVIEW_LABEL="working copy"
  REVIEW_FILE="review_$(date '+%Y%m%d_%H%M%S').md"
  HEADER_META="- **Directory:** $(pwd)"
fi

# === Build Prompts ===
CLAUDE_PROMPT="$REVIEW_CONTEXT

$REVIEW_SYSTEM_PROMPT"

CODEX_PROMPT="$REVIEW_CONTEXT

$REVIEW_SYSTEM_PROMPT"

# === Run Reviews ===
CLAUDE_EXIT=0
CODEX_EXIT=0

run_claude() {
  claude -p "$CLAUDE_PROMPT" \
    --max-turns 99 \
    --output-format stream-json --verbose \
    > "$TEMP_DIR/claude_review_stream.jsonl" 2>"$TEMP_DIR/claude_stderr.txt"
  # Extract all assistant text messages from stream
  jq -r 'select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text' \
    "$TEMP_DIR/claude_review_stream.jsonl" > "$TEMP_DIR/claude_review.txt"
}

run_codex() {
  codex exec --full-auto "$CODEX_PROMPT" \
    > "$TEMP_DIR/codex_review.txt" 2>"$TEMP_DIR/codex_stderr.txt"
}

# Run a reviewer function with one retry on failure
run_with_retry() {
  local func="$1" label="$2" output="$3"
  local stderr_file="${output%.txt}_stderr.txt"
  local exit_code=0
  $func 2>/dev/null || exit_code=$?
  if [ $exit_code -ne 0 ] && [ $exit_code -ne 130 ]; then
    echo "  ⟳ $label failed (exit $exit_code), retrying..." >&2
    [ -s "$stderr_file" ] && echo "  Stderr: $(head -3 "$stderr_file")" >&2
    exit_code=0
    $func 2>/dev/null || exit_code=$?
  fi
  return $exit_code
}

if [ "$RUN_CLAUDE" = true ] && [ "$RUN_CODEX" = true ]; then
  echo "Running Claude and Codex reviews in parallel..."
  REVIEW_START=$SECONDS

  (run_with_retry run_claude "Claude" "$TEMP_DIR/claude_review.txt") &
  CLAUDE_PID=$!

  (run_with_retry run_codex "Codex" "$TEMP_DIR/codex_review.txt") &
  CODEX_PID=$!

  start_progress

  wait $CLAUDE_PID 2>/dev/null || CLAUDE_EXIT=$?
  CLAUDE_ELAPSED=$(( SECONDS - REVIEW_START ))

  wait $CODEX_PID 2>/dev/null || CODEX_EXIT=$?
  CODEX_ELAPSED=$(( SECONDS - REVIEW_START ))

  stop_progress

  if [ $CLAUDE_EXIT -eq 0 ]; then
    echo "  ✓ Claude: done (${CLAUDE_ELAPSED}s)"
  else
    echo "  ✗ Claude: failed (${CLAUDE_ELAPSED}s, exit $CLAUDE_EXIT)"
    [ -s "$TEMP_DIR/claude_stderr.txt" ] && echo "  $(head -3 "$TEMP_DIR/claude_stderr.txt")"
  fi
  if [ $CODEX_EXIT -eq 0 ]; then
    echo "  ✓ Codex: done (${CODEX_ELAPSED}s)"
  else
    echo "  ✗ Codex: failed (${CODEX_ELAPSED}s, exit $CODEX_EXIT)"
    [ -s "$TEMP_DIR/codex_stderr.txt" ] && echo "  $(head -3 "$TEMP_DIR/codex_stderr.txt")"
  fi

elif [ "$RUN_CLAUDE" = true ]; then
  echo "Running Claude review..."
  REVIEW_START=$SECONDS
  start_progress
  run_with_retry run_claude "Claude" "$TEMP_DIR/claude_review.txt" || CLAUDE_EXIT=$?
  stop_progress
  CLAUDE_ELAPSED=$(( SECONDS - REVIEW_START ))
  if [ $CLAUDE_EXIT -eq 0 ]; then
    echo "  ✓ Claude: done (${CLAUDE_ELAPSED}s)"
  else
    echo "  ✗ Claude: failed (${CLAUDE_ELAPSED}s, exit $CLAUDE_EXIT)"
    [ -s "$TEMP_DIR/claude_stderr.txt" ] && echo "  $(head -3 "$TEMP_DIR/claude_stderr.txt")"
  fi

elif [ "$RUN_CODEX" = true ]; then
  echo "Running Codex review..."
  REVIEW_START=$SECONDS
  start_progress
  run_with_retry run_codex "Codex" "$TEMP_DIR/codex_review.txt" || CODEX_EXIT=$?
  stop_progress
  CODEX_ELAPSED=$(( SECONDS - REVIEW_START ))
  if [ $CODEX_EXIT -eq 0 ]; then
    echo "  ✓ Codex: done (${CODEX_ELAPSED}s)"
  else
    echo "  ✗ Codex: failed (${CODEX_ELAPSED}s, exit $CODEX_EXIT)"
    [ -s "$TEMP_DIR/codex_stderr.txt" ] && echo "  $(head -3 "$TEMP_DIR/codex_stderr.txt")"
  fi
fi

echo ""

# === Stage 2: Consolidation ===
CONSOLIDATION_INPUT=""
if [ "$RUN_CLAUDE" = true ] && [ $CLAUDE_EXIT -eq 0 ] && [ -s "$TEMP_DIR/claude_review.txt" ]; then
  CONSOLIDATION_INPUT+="=== REVIEW 1 (Claude) ===
$(cat "$TEMP_DIR/claude_review.txt")

"
fi
if [ "$RUN_CODEX" = true ] && [ $CODEX_EXIT -eq 0 ] && [ -s "$TEMP_DIR/codex_review.txt" ]; then
  CONSOLIDATION_INPUT+="=== REVIEW 2 (Codex) ===
$(cat "$TEMP_DIR/codex_review.txt")

"
fi

CONSOLIDATE_EXIT=0
if [ -n "$CONSOLIDATION_INPUT" ]; then
  echo "Consolidating findings..."
  start_progress

  claude -p "Consolidate these code reviews for $REVIEW_LABEL.

$CONSOLIDATION_INPUT

$CONSOLIDATE_SYSTEM_PROMPT" \
    --max-turns 10 \
    > "$TEMP_DIR/consolidated.txt" 2>"$TEMP_DIR/consolidate_stderr.txt" || CONSOLIDATE_EXIT=$?

  stop_progress

  if [ $CONSOLIDATE_EXIT -eq 0 ]; then
    echo "  ✓ Consolidation: done"
  else
    echo "  ✗ Consolidation: failed (exit $CONSOLIDATE_EXIT)"
  fi
else
  echo "Skipping consolidation — no successful reviews to consolidate"
fi

# Parse verdict from consolidated output
VERDICT="UNKNOWN"
if [ -f "$TEMP_DIR/consolidated.txt" ] && [ $CONSOLIDATE_EXIT -eq 0 ]; then
  VERDICT_LINE=$({ grep -E '^VERDICT: (APPROVE|BLOCK)$' "$TEMP_DIR/consolidated.txt" || true; } | tail -1)
  if [ -n "$VERDICT_LINE" ]; then
    VERDICT="${VERDICT_LINE#VERDICT: }"
  fi
fi

# === Write Review File ===
{
  echo "# Review: $REVIEW_LABEL"
  echo ""
  echo "$HEADER_META"
  echo "- **Reviewed:** $(date '+%Y-%m-%d %H:%M')"
  echo ""

  # Consolidated verdict and findings at the top
  if [ -f "$TEMP_DIR/consolidated.txt" ] && [ $CONSOLIDATE_EXIT -eq 0 ]; then
    echo "## Verdict: $VERDICT"
    echo ""
    grep -v '^VERDICT: ' "$TEMP_DIR/consolidated.txt" || true
    echo ""
  else
    echo "## Verdict: UNKNOWN"
    echo ""
    echo "> Consolidation failed — see raw reviews below."
    echo ""
  fi

  # Raw reviews in collapsible details blocks
  if [ "$RUN_CLAUDE" = true ]; then
    echo "---"
    echo ""
    echo "<details>"
    echo "<summary>Raw Claude Review</summary>"
    echo ""
    if [ $CLAUDE_EXIT -eq 0 ]; then
      cat "$TEMP_DIR/claude_review.txt"
    else
      echo "> **Failed** (exit code: $CLAUDE_EXIT)"
      cat "$TEMP_DIR/claude_review.txt" 2>/dev/null || echo "(no output)"
    fi
    echo ""
    echo "</details>"
    echo ""
  fi

  if [ "$RUN_CODEX" = true ]; then
    echo "<details>"
    echo "<summary>Raw Codex Review</summary>"
    echo ""
    if [ $CODEX_EXIT -eq 0 ]; then
      cat "$TEMP_DIR/codex_review.txt"
    else
      echo "> **Failed** (exit code: $CODEX_EXIT)"
      cat "$TEMP_DIR/codex_review.txt" 2>/dev/null || echo "(no output)"
    fi
    echo ""
    echo "</details>"
    echo ""
  fi
} > "$REVIEW_FILE"

# === Persist Debug Artifacts ===
DEBUG_DIR="$(dirname "$REVIEW_FILE")/.pr-review-debug"
mkdir -p "$DEBUG_DIR"
cp "$TEMP_DIR/claude_review_stream.jsonl" "$DEBUG_DIR/" 2>/dev/null || true
cp "$TEMP_DIR/codex_review.txt" "$DEBUG_DIR/" 2>/dev/null || true
cp "$TEMP_DIR/consolidated.txt" "$DEBUG_DIR/" 2>/dev/null || true
# Generate human-readable transcript of the full Claude conversation
if [ -s "$TEMP_DIR/claude_review_stream.jsonl" ]; then
  jq -r '
    if .type == "user" then
      "\n══ USER ══\n" + (.message.content // [] | map(
        if .type == "text" then .text
        elif .type == "tool_result" then "[tool_result: \(.tool_use_id // "?")]"
        else "[" + (.type // "unknown") + "]"
        end
      ) | join("\n"))
    elif .type == "assistant" then
      "\n══ ASSISTANT ══\n" + (.message.content // [] | map(
        if .type == "text" then .text
        elif .type == "tool_use" then "[tool: \(.name // "?")](\(.input | tostring | .[0:200]))"
        else "[" + (.type // "unknown") + "]"
        end
      ) | join("\n"))
    else empty
    end
  ' "$TEMP_DIR/claude_review_stream.jsonl" > "$DEBUG_DIR/claude_conversation.txt" 2>/dev/null || true
fi

# === Present Results ===
echo ""
cat "$REVIEW_FILE"
echo ""
echo "════════════════════════════════════════════════════════════════"
echo "  Review saved to: $(pwd)/$REVIEW_FILE"
echo "  Debug files: $DEBUG_DIR/"
echo "════════════════════════════════════════════════════════════════"

# Exit with error only if all review tools failed
if [ "$RUN_CLAUDE" = true ] && [ "$RUN_CODEX" = true ]; then
  if [ $CLAUDE_EXIT -ne 0 ] && [ $CODEX_EXIT -ne 0 ]; then
    echo "Error: Both review tools failed"
    exit 1
  fi
elif [ "$RUN_CLAUDE" = true ] && [ $CLAUDE_EXIT -ne 0 ]; then
  exit $CLAUDE_EXIT
elif [ "$RUN_CODEX" = true ] && [ $CODEX_EXIT -ne 0 ]; then
  exit $CODEX_EXIT
fi
